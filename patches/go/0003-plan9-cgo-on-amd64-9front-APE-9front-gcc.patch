diff --git a/src/runtime/cgo/gcc_plan9.c b/src/runtime/cgo/gcc_plan9.c
new file mode 100644
index 00000000..531d3e55
--- /dev/null
+++ b/src/runtime/cgo/gcc_plan9.c
@@ -0,0 +1,25 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build plan9
+
+#include "libcgo.h"
+
+// Plan 9 has no TLS: a proc's private data are slots at a fixed address
+// in its stack segment, which every proc (rfork(RFMEM)) has a copy of.
+// The runtime keeps g in the word before the one _goprivates points at
+// (the assembler's TLS on plan9 is -8(_goprivates) on amd64; rt0_plan9_*.s
+// sets it for a program without cgo). In a cgo program APE's start
+// (_callmain) owns the slots: _privates, slot 0 is the pthread's (APE's
+// gnu/pthread.c), slot 1 the runtime's; a new thread's slots are empty.
+extern void **_privates;
+extern void **_goprivates;
+
+static void
+inittls(void **tlsg, void **tlsbase)
+{
+	_goprivates = &_privates[2];	/* g in _privates[1] */
+}
+
+void (*x_cgo_inittls)(void **tlsg, void **tlsbase) = inittls;
