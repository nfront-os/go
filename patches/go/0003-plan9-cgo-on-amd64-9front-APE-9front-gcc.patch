diff --git a/src/runtime/mem_plan9.go b/src/runtime/mem_plan9.go
index 9b18a291..bfeabf69 100644
--- a/src/runtime/mem_plan9.go
+++ b/src/runtime/mem_plan9.go
@@ -6,12 +6,40 @@ package runtime
 
 import "unsafe"
 
+// In a cgo program APE's malloc has the break (it starts at end, as
+// the runtime's would): the runtime's heap is a segment of its own
+// then (segattach "memory" at heapSegBase), which segbrk grows. osinit
+// makes it, before there is another proc: a proc that rfork(RFMEM)
+// makes shares the segments its parent has, and their growth.
+var heapSeg bool
+
+var memoryClass = []byte("memory\x00")
+
+//go:noescape
+func segattach(attr int32, class *byte, va unsafe.Pointer, len uintptr) uintptr
+
+func segbrk(saddr, addr unsafe.Pointer) int32
+
+func initHeapSeg() {
+	base := uintptr(heapSegBase)
+	if segattach(0, &memoryClass[0], unsafe.Pointer(base), physPageSize) != base {
+		throw("runtime: cannot attach the heap segment")
+	}
+	heapSeg = true
+	bloc = base
+	blocMax = base + physPageSize
+}
+
 func sbrk(n uintptr) unsafe.Pointer {
 	// Plan 9 sbrk from /sys/src/libc/9sys/sbrk.c
 	bl := bloc
 	n = memRound(n)
 	if bl+n > blocMax {
-		if brk_(unsafe.Pointer(bl+n)) < 0 {
+		if heapSeg {
+			if segbrk(unsafe.Pointer(uintptr(heapSegBase)), unsafe.Pointer(bl+n)) < 0 {
+				return nil
+			}
+		} else if brk_(unsafe.Pointer(bl+n)) < 0 {
 			return nil
 		}
 		blocMax = bl + n
diff --git a/src/runtime/os_plan9.go b/src/runtime/os_plan9.go
index 85e1ecdb..35206e0f 100644
--- a/src/runtime/os_plan9.go
+++ b/src/runtime/os_plan9.go
@@ -213,6 +213,11 @@ func minit() {
 	// Mask all SSE floating-point exceptions
 	// when running on the 64-bit kernel.
 	setfpmasks()
+	// A thread of runtime/cgo (a pthread) did not start in
+	// tstart_plan9, which sets procid from Tos.
+	if iscgo && getg().m.procid == 0 {
+		getg().m.procid = getpid()
+	}
 }
 
 // Called from dropm to undo the effect of an minit.
@@ -330,6 +335,9 @@ var (
 func osinit() {
 	physPageSize = getPageSize()
 	initBloc()
+	if iscgo {
+		initHeapSeg() // mem_plan9.go
+	}
 	numCPUStartup = getCPUCount()
 	getg().m.procid = getpid()
 
