+	SVC
+	MOVW	R0, ret+8(FP)
+	RET
+
+//func plan9_semacquire(addr *uint32, block int32) int32
+TEXT runtime·plan9_semacquire(SB),NOSPLIT,$0-20
+	MOVD	$SYS_SEMACQUIRE, R0
+	SVC
+	MOVW	R0, ret+16(FP)
+	RET
