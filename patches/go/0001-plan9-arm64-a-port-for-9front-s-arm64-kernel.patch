+	MOVW	new+4(FP), R2
+	MOVD	R1, 8(RSP)
+	MOVD	R2, 16(RSP)
+	MOVD	$SYS_DUP, R0
+	SVC
+	MOVW	R0, ret+8(FP)
+	RET
+
+//func exits(msg *byte)
+TEXT runtime·exits(SB),NOSPLIT,$0-8
+	MOVD	$SYS_EXITS, R0
+	SVC
+	RET
