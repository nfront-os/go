+package runtime
+
+const _PAGESIZE = 0x1000
+
+// Ureg of 9front's arm64 kernel (/arm64/include/ureg.h).
+type ureg struct {
+	r0   uint64 /* general registers */
+	r1   uint64
+	r2   uint64
+	r3   uint64
+	r4   uint64
+	r5   uint64
+	r6   uint64
+	r7   uint64
+	r8   uint64
+	r9   uint64
+	r10  uint64
+	r11  uint64
