+	r20  uint64
+	r21  uint64
+	r22  uint64
+	r23  uint64
+	r24  uint64
+	r25  uint64
+	r26  uint64
+	r27  uint64
+	r28  uint64 /* g */
+	r29  uint64
+	link uint64 /* r30 */
+	sp   uint64
+	pc   uint64 /* interrupted addr */
+	psr  uint64
+	typ  uint64 /* of exception */
+}
+
+type sigctxt struct {
+	u *ureg
+}
+
+//go:nosplit
+//go:nowritebarrierrec
+func (c *sigctxt) pc() uintptr { return uintptr(c.u.pc) }
+
+func (c *sigctxt) sp() uintptr { return uintptr(c.u.sp) }
+func (c *sigctxt) lr() uintptr { return uintptr(c.u.link) }
+
+func (c *sigctxt) setpc(x uintptr) { c.u.pc = uint64(x) }
+func (c *sigctxt) setsp(x uintptr) { c.u.sp = uint64(x) }
+func (c *sigctxt) setlr(x uintptr) { c.u.link = uint64(x) }
+
+// savelr keeps the interrupted LR for sigpanictramp, which pushes it
+// as the faulting function's saved LR.
+func (c *sigctxt) savelr(x uintptr) { c.u.r0 = uint64(x) }
+
+func dumpregs(u *ureg) {
+	print("r0    ", hex(u.r0), "\n")
+	print("r1    ", hex(u.r1), "\n")
