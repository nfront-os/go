+//func seek(fd int32, offset int64, whence int32) int64
+// The kernel's seek takes a pointer to the result first.
+TEXT runtime·seek(SB),NOSPLIT,$32-32
+	MOVD	$ret+24(FP), R0
+	MOVW	fd+0(FP), R1
+	MOVD	offset+8(FP), R2
+	MOVW	whence+16(FP), R3
+	MOVD	R0, 8(RSP)
+	MOVD	R1, 16(RSP)
+	MOVD	R2, 24(RSP)
+	MOVD	R3, 32(RSP)
