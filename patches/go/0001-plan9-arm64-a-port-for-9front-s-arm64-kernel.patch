+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+#include "textflag.h"
+
+// 9front's arm64 kernel starts a program with R0 = its Tos,
+// argc at 0(RSP) and the argv pointers following it.
+TEXT _rt0_arm64_plan9(SB),NOSPLIT|NOFRAME,$0
+	MOVD	R0, _tos(SB)
+	MOVD	0(RSP), R0	// argc
+	ADD	$8, RSP, R1	// argv
+	MOVD	RSP, R2		// a 16-byte aligned stack for rt0_go
+	AND	$~15, R2
+	MOVD	R2, RSP
+	B	runtime·rt0_go(SB)
+
+GLOBL _tos(SB), NOPTR, $8
