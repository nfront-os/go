+#include "textflag.h"
+#include "funcdata.h"
+
+//
+// System call support for Plan 9 on arm64 (9front): the number in R0, SVC;
+// the kernel reads the arguments from 8(RSP) on, one 8-byte slot each, and
+// returns the result in R0.
+//
+
+//func Syscall(trap, a1, a2, a3 uintptr) (r1, r2 uintptr, err string)
+//func Syscall6(trap, a1, a2, a3, a4, a5, a6 uintptr) (r1, r2 uintptr, err string)
+//func RawSyscall(trap, a1, a2, a3 uintptr) (r1, r2, err uintptr)
+//func RawSyscall6(trap, a1, a2, a3, a4, a5, a6 uintptr) (r1, r2, err uintptr)
+
+#define SYS_ERRSTR 41	/* from zsysnum_plan9.go */
+#define SYS_SEEK 39	/* from zsysnum_plan9.go */
+
+// The frame of Syscall and Syscall6: the arguments at 8(RSP) (six slots),
+// the error buffer at 64(RSP) (ERRMAX, 128 bytes).
+
+TEXT	·Syscall(SB),NOSPLIT,$192-64
+	NO_LOCAL_POINTERS
+	BL	runtime·entersyscall<ABIInternal>(SB)
+	MOVD	a1+8(FP), R1
+	MOVD	a2+16(FP), R2
+	MOVD	a3+24(FP), R3
+	MOVD	R1, 8(RSP)
+	MOVD	R2, 16(RSP)
+	MOVD	R3, 24(RSP)
+	MOVD	trap+0(FP), R0
+	SVC
+	MOVD	R0, r1+32(FP)
+	MOVD	ZR, r2+40(FP)
+	CMN	$1, R0
+	BNE	ok3
+
+	ADD	$64, RSP, R1
+	MOVD	R1, 8(RSP)
+	MOVD	$128, R2
+	MOVD	R2, 16(RSP)
+	MOVD	$SYS_ERRSTR, R0
+	SVC
+	BL	runtime·exitsyscall(SB) // call via ABI wrapper, ensuring ABIInternal fixed registers are set
+	ADD	$64, RSP, R1
+	MOVD	R1, 8(RSP)
+	BL	runtime·gostring(SB)
+	MOVD	16(RSP), R1
+	MOVD	24(RSP), R2
+	B	copyresult3
+
+ok3:
+	BL	runtime·exitsyscall(SB) // call via ABI wrapper, ensuring ABIInternal fixed registers are set
+	MOVD	$·emptystring(SB), R3
+	MOVD	0(R3), R1
+	MOVD	8(R3), R2
+
+copyresult3:
+	MOVD	R1, err_base+48(FP)
+	MOVD	R2, err_len+56(FP)
+	RET
+
+TEXT	·Syscall6(SB),NOSPLIT,$192-88
+	NO_LOCAL_POINTERS
+	BL	runtime·entersyscall<ABIInternal>(SB)
+	MOVD	a1+8(FP), R1
+	MOVD	a2+16(FP), R2
+	MOVD	a3+24(FP), R3
+	MOVD	a4+32(FP), R4
+	MOVD	a5+40(FP), R5
+	MOVD	a6+48(FP), R6
+	MOVD	R1, 8(RSP)
+	MOVD	R2, 16(RSP)
+	MOVD	R3, 24(RSP)
+	MOVD	R4, 32(RSP)
+	MOVD	R5, 40(RSP)
+	MOVD	R6, 48(RSP)
+	MOVD	trap+0(FP), R0
+	SVC
+	MOVD	R0, r1+56(FP)
+	MOVD	ZR, r2+64(FP)
+	CMN	$1, R0
+	BNE	ok4
+
+	ADD	$64, RSP, R1
+	MOVD	R1, 8(RSP)
+	MOVD	$128, R2
+	MOVD	R2, 16(RSP)
+	MOVD	$SYS_ERRSTR, R0
+	SVC
+	BL	runtime·exitsyscall(SB) // call via ABI wrapper, ensuring ABIInternal fixed registers are set
+	ADD	$64, RSP, R1
+	MOVD	R1, 8(RSP)
+	BL	runtime·gostring(SB)
+	MOVD	16(RSP), R1
+	MOVD	24(RSP), R2
+	B	copyresult4
+
+ok4:
+	BL	runtime·exitsyscall(SB) // call via ABI wrapper, ensuring ABIInternal fixed registers are set
+	MOVD	$·emptystring(SB), R3
+	MOVD	0(R3), R1
+	MOVD	8(R3), R2
+
+copyresult4:
+	MOVD	R1, err_base+72(FP)
+	MOVD	R2, err_len+80(FP)
+	RET
+
+TEXT ·RawSyscall(SB),NOSPLIT,$32-56
+	MOVD	a1+8(FP), R1
+	MOVD	a2+16(FP), R2
+	MOVD	a3+24(FP), R3
+	MOVD	R1, 8(RSP)
+	MOVD	R2, 16(RSP)
+	MOVD	R3, 24(RSP)
+	MOVD	trap+0(FP), R0
+	SVC
+	MOVD	R0, r1+32(FP)
+	MOVD	R0, r2+40(FP)
+	MOVD	R0, err+48(FP)
+	RET
+
+TEXT	·RawSyscall6(SB),NOSPLIT,$48-80
+	MOVD	a1+8(FP), R1
+	MOVD	a2+16(FP), R2
+	MOVD	a3+24(FP), R3
+	MOVD	a4+32(FP), R4
+	MOVD	a5+40(FP), R5
+	MOVD	a6+48(FP), R6
+	MOVD	R1, 8(RSP)
+	MOVD	R2, 16(RSP)
+	MOVD	R3, 24(RSP)
+	MOVD	R4, 32(RSP)
+	MOVD	R5, 40(RSP)
+	MOVD	R6, 48(RSP)
+	MOVD	trap+0(FP), R0
+	SVC
+	MOVD	R0, r1+56(FP)
+	MOVD	R0, r2+64(FP)
+	MOVD	R0, err+72(FP)
+	RET
+
+//func seek(placeholder uintptr, fd int, offset int64, whence int) (newoffset int64, err string)
+// The kernel's seek takes a pointer to the result first (the placeholder's slot).
+TEXT ·seek(SB),NOSPLIT,$48-56
+	NO_LOCAL_POINTERS
+	MOVD	$newoffset+32(FP), R0
+	MOVD	fd+8(FP), R1
+	MOVD	offset+16(FP), R2
+	MOVD	whence+24(FP), R3
+	MOVD	R0, 8(RSP)
+	MOVD	R1, 16(RSP)
+	MOVD	R2, 24(RSP)
+	MOVD	R3, 32(RSP)
+	MOVD	$SYS_SEEK, R0
+	SVC
+	CMN	$1, R0
+	BNE	ok6
+	MOVD	R0, newoffset+32(FP)
+
+	BL	syscall·errstr(SB)
+	MOVD	8(RSP), R1
+	MOVD	16(RSP), R2
+	B	copyresult6
+
+ok6:
+	MOVD	$·emptystring(SB), R3
+	MOVD	0(R3), R1
+	MOVD	8(R3), R2
+
+copyresult6:
+	MOVD	R1, err_base+40(FP)
+	MOVD	R2, err_len+48(FP)
+	RET
