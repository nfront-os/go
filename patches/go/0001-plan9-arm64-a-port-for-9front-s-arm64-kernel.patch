-		ld.HEADR = 32
+		// 9front's arm64 a.out (7l -H2): the 64-bit header (R_MAGIC),
+		// text at 0x10000, data on the next 64K boundary.
+		ld.HEADR = 32 + 8
 		if *ld.FlagRound == -1 {
-			*ld.FlagRound = 4096
+			*ld.FlagRound = 0x10000
 		}
 		if *ld.FlagTextAddr == -1 {
-			*ld.FlagTextAddr = ld.Rnd(4096, *ld.FlagRound) + int64(ld.HEADR)
+			*ld.FlagTextAddr = ld.Rnd(0x10000, *ld.FlagRound) + int64(ld.HEADR)
