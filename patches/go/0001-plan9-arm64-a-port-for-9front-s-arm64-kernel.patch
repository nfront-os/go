+//func tstart_plan9(newm *m)
+TEXT runtime·tstart_plan9(SB),NOSPLIT,$16-8
+	MOVD	newm+0(FP), R1
+	MOVD	m_g0(R1), g
+
+	// Layout new m scheduler stack on os stack.
+	MOVD	RSP, R0
+	MOVD	R0, (g_stack+stack_hi)(g)
+	SUB	$(64*1024), R0
+	MOVD	R0, (g_stack+stack_lo)(g)
+	MOVD	R0, g_stackguard0(g)
+	MOVD	R0, g_stackguard1(g)
+
+	// Initialize procid from TOS struct.
+	MOVD	_tos(SB), R0
+	MOVWU	64(R0), R0
+	MOVD	R0, m_procid(R1)	// save pid as m->procid
+
+	BL	runtime·mstart(SB)
+
+	// Exit the thread.
+	MOVD	$0, R0
+	MOVD	R0, 8(RSP)
+	BL	runtime·exits(SB)
+	B	0(PC)
+
+//func sigtramp(ureg, note unsafe.Pointer)
+// The kernel calls it with R0 = ureg, the arguments at 8(RSP) and 16(RSP)
+// and LR = 0; g (R28) is the interrupted one. It never returns: noted
+// resumes the interrupted context.
+TEXT runtime·sigtramp(SB),NOSPLIT|NOFRAME,$0-16
+	// check that g and m exist
+	CBZ	g, bad
+	MOVD	g_m(g), R1
+	CBZ	R1, bad
+
+	// save args
+	MOVD	ureg+0(FP), R2
+	MOVD	note+8(FP), R3
+
+	// change stack
+	MOVD	m_gsignal(R1), R4
+	MOVD	(g_stack+stack_hi)(R4), R5
+	MOVD	R5, RSP
+
+	// make room for the LR slot, args, retval and g
+	SUB	$48, RSP
+
+	// save g
+	MOVD	g, 40(RSP)
+
+	// sighandler(ureg, note, gp) on m->gsignal
+	MOVD	R2, 8(RSP)
+	MOVD	R3, 16(RSP)
+	MOVD	g, 24(RSP)
+	MOVD	R4, g
+	BL	runtime·sighandler(SB)
+	MOVD	32(RSP), R0	// retval
+
+	// restore g
+	MOVD	40(RSP), g
+
+	// call noted(R0)
+	MOVD	R0, 8(RSP)
+	BL	runtime·noted(SB)
+	B	0(PC)
+bad:
+	BL	runtime·badsignal2(SB)	// will exit
+	B	0(PC)
+
+//func sigpanictramp()
+// sighandler left the faulting function's LR in R0 and the faulting
+// pc in LR: push R0 as that function's saved LR, as signal_arm64.go's
+// preparePanic does, and enter sigpanic.
+TEXT runtime·sigpanictramp(SB),NOSPLIT|NOFRAME,$0-0
+	MOVD.W	R0, -16(RSP)
+	B	runtime·sigpanic<ABIInternal>(SB)
+
+//func setfpmasks()
+// Only used by the 64-bit runtime.
+TEXT runtime·setfpmasks(SB),NOSPLIT,$0
+	RET
+
+#define ERRMAX 128	/* from os_plan9.h */
+
+// func errstr() string
+// Only used by package syscall.
+// Grab error string due to a syscall made
+// in entersyscall mode, without going
+// through the allocator (issue 4994).
+// The result's slots are the system call's arguments (buf, len).
+// See ../syscall/asm_plan9_arm64.s:/·Syscall/
+TEXT runtime·errstr(SB),NOSPLIT,$0-16
+	MOVD	g_m(g), R0
+	MOVD	(m_mOS+mOS_errstr)(R0), R1
+	MOVD	R1, ret_base+0(FP)
+	MOVD	$ERRMAX, R2
+	MOVD	R2, ret_len+8(FP)
+	MOVD	$SYS_ERRSTR, R0
+	SVC
+	MOVD	R1, R2
+loop:
+	MOVBU	0(R2), R0
+	CBZ	R0, done
+	ADD	$1, R2
+	B	loop
+done:
+	SUB	R1, R2
+	MOVD	R2, ret_len+8(FP)
+	RET
