@@ -47,6 +47,9 @@ func Init() (*sys.Arch, ld.Arch) {
 		Dwarfreglr: dwarfRegLR,
 		TrampLimit: 0x7c00000, // 26-bit signed offset * 4, leave room for PLT etc.
 
+		Plan9Magic:  uint32(4*28*28 + 7), // R_MAGIC
+		Plan9_64Bit: true,
+
 		Adddynrel:        adddynrel,
 		Archinit:         archinit,
 		Archreloc:        archreloc,
@@ -85,12 +88,14 @@ func archinit(ctxt *ld.Link) {
