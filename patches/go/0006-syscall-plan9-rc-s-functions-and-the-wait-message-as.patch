diff --git a/src/syscall/exec_plan9.go b/src/syscall/exec_plan9.go
index f0481e8b..1da00739 100644
--- a/src/syscall/exec_plan9.go
+++ b/src/syscall/exec_plan9.go
@@ -345,6 +345,20 @@ type envItem struct {
 	nvalue int
 }
 
+// envValue is what the file /env/name holds for name=value, as rc writes
+// it: a variable is a list, each word ended by a NUL (the runtime drops
+// the last NUL when it reads one, goenvs), but a function, fn#name, is rc
+// source that rc reads back with ". -bq": a NUL after it is a syntax error.
+// Its capacity is at least 1.
+func envValue(name, value string) []byte {
+	b := make([]byte, len(value), len(value)+1)
+	copy(b, value)
+	if len(name) < 3 || name[:3] != "fn#" {
+		b = append(b, 0)
+	}
+	return b
+}
+
 type ProcAttr struct {
 	Dir   string    // Current working directory.
 	Env   []string  // Environment.
@@ -414,9 +428,11 @@ func forkExec(argv0 string, argv []string, attr *ProcAttr) (pid int, err error)
 			if err != nil {
 				return 0, err
 			}
-			envvalue := make([]byte, len(v)-i)
-			copy(envvalue, v[i+1:])
-			envvParsed = append(envvParsed, envItem{envname, &envvalue[0], len(v) - i})
+			envvalue := envValue(v[:i], v[min(i+1, len(v)):])
+			// an empty function (rc leaves /env/fn#x empty after fn x)
+			// is written as 0 bytes, but from a valid address: the
+			// kernel refuses nil even then
+			envvParsed = append(envvParsed, envItem{envname, &envvalue[:1][0], len(envvalue)})
 		}
 	}
 
@@ -553,7 +569,7 @@ func Exec(argv0 string, argv []string, envv []string) (err error) {
 				return e
 			}
 
-			_, e = Write(fd, []byte(v[i+1:]))
+			_, e = Write(fd, envValue(v[:i], v[min(i+1, len(v)):]))
 			if e != nil {
 				Close(fd)
 				return e
diff --git a/src/syscall/syscall_plan9.go b/src/syscall/syscall_plan9.go
index 2a6229b2..b9aa6102 100644
--- a/src/syscall/syscall_plan9.go
+++ b/src/syscall/syscall_plan9.go
@@ -321,14 +321,43 @@ func Await(w *Waitmsg) (err error) {
 	w.Time[0] = uint32(atoi(f[1]))
 	w.Time[1] = uint32(atoi(f[2]))
 	w.Time[2] = uint32(atoi(f[3]))
-	w.Msg = cstring(f[4])
-	if w.Msg == "''" {
-		// await() returns '' for no error
-		w.Msg = ""
-	}
+	// the kernel quotes the message (%q: 'rc 123: x' for rc 123: x, ''
+	// for no error); Msg is the message itself, as libc's wait gives it
+	w.Msg = unquoteWaitMsg(cstring(f[4]))
 	return
 }
 
+// unquoteWaitMsg undoes the kernel's %q quoting of a wait message, as
+// tokenize(2) does: quotes are dropped, a doubled quote inside them is one.
+func unquoteWaitMsg(s string) string {
+	q := false
+	for i := 0; i < len(s); i++ {
+		if s[i] == '\'' {
+			q = true
+			break
+		}
+	}
+	if !q {
+		return s
+	}
+	b := make([]byte, 0, len(s))
+	in := false
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if c != '\'' {
+			b = append(b, c)
+			continue
+		}
+		if in && i+1 < len(s) && s[i+1] == '\'' {
+			b = append(b, '\'')
+			i++
+			continue
+		}
+		in = !in
+	}
+	return string(b)
+}
