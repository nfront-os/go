 	return nanotime()
 }
 
-// The runtime's heap segment in a cgo program (mem_plan9.go): above
-// what the break (APE's malloc) is likely to reach.
-const heapSegBase = 0x100000000000
+// The runtime's heap segment in a cgo program (mem_plan9.go). 9front's
+// arm64 user space is 32 GB (EVASHIFT 36), a segment has at most 8 GB
+// (SEGMAPSIZE): from 8 GB the break (APE's malloc) and the runtime each
+// get a segment's most.
+const heapSegBase = 0x200000000
diff --git a/src/runtime/rt0_plan9_arm64.s b/src/runtime/rt0_plan9_arm64.s
index d9d80ded..f4275e3c 100644
--- a/src/runtime/rt0_plan9_arm64.s
+++ b/src/runtime/rt0_plan9_arm64.s
@@ -16,3 +16,6 @@ TEXT _rt0_arm64_plan9(SB),NOSPLIT|NOFRAME,$0
 	B	runtime·rt0_go(SB)
 
 GLOBL _tos(SB), NOPTR, $8
+// the pointer to the runtime's slot for g in a cgo program (tls_arm64.s);
+// set by runtime/cgo, unused without cgo (g is only in R28 then)
+GLOBL _goprivates(SB), NOPTR, $8
