index 531d3e55..3fffcc2c 100644
--- a/src/runtime/cgo/gcc_plan9.c
+++ b/src/runtime/cgo/gcc_plan9.c
@@ -23,3 +23,14 @@ inittls(void **tlsg, void **tlsbase)
 }
 
 void (*x_cgo_inittls)(void **tlsg, void **tlsbase) = inittls;
+
+// exit (runtime/os_plan9.go): APE's pthreads include threads of C's own,
+// which are not the runtime's ms; APE ends them all but the caller, as its
+// exit does (proc(3)'s ctl "kill").
+extern void __pthread_killothers(void);
+
+void
+x_cgo_exitall(void *dummy)
+{
+	__pthread_killothers();
+}
diff --git a/src/runtime/cgo/plan9.go b/src/runtime/cgo/plan9.go
index 14ff4a4e..49edb66d 100644
--- a/src/runtime/cgo/plan9.go
+++ b/src/runtime/cgo/plan9.go
@@ -15,3 +15,11 @@ import _ "unsafe" // for go:linkname
 
 //go:cgo_export_static _goprivates
 //go:cgo_export_static _tos
+
+// exit: APE ends the threads (gcc_plan9.c).
+
+//go:cgo_import_static x_cgo_exitall
+//go:linkname x_cgo_exitall x_cgo_exitall
+//go:linkname _cgo_exitall _cgo_exitall
+var x_cgo_exitall byte
+var _cgo_exitall = &x_cgo_exitall
diff --git a/src/runtime/os_plan9.go b/src/runtime/os_plan9.go
index 35206e0f..0a28b68e 100644
--- a/src/runtime/os_plan9.go
+++ b/src/runtime/os_plan9.go
@@ -460,7 +460,10 @@ func exit(e int32) {
 		// Don't append, rely on the existing data being zero.
 		status = sl[:len(sl)+1]
 	}
-	goexitsall(&status[0])
+	goexitsall(&status[0]) // first: sets exiting, a new m ends in minit
+	if iscgo && _cgo_exitall != nil {
+		asmcgocall(_cgo_exitall, nil)
+	}
 	exits(&status[0])
 }
 
@@ -535,6 +538,32 @@ func badsignal2() {
 	exits(&_badsignal[0])
 }
 
+// badnote takes a note on a proc the runtime does not know (sigtramp found
+// no g). In a cgo program that is a thread of C's own, which never called
+// Go: a trap of its own ("sys: ...") takes the default (the proc dies, as
+// in a C program); any other note it leaves alone (noted NCONT): one that
+// came to the note group the runtime's threads got as well. Without cgo
+// there is no such proc (badsignal2).
+//
+//go:nosplit
+//go:nowritebarrierrec
+func badnote(note *byte) {
+	if !iscgo {
+		badsignal2()
+	}
+	if *note == 's' && *(*byte)(add(unsafe.Pointer(note), 1)) == 'y' &&
+		*(*byte)(add(unsafe.Pointer(note), 2)) == 's' && *(*byte)(add(unsafe.Pointer(note), 3)) == ':' {
+		noted(_NDFLT)
+	}
+	noted(_NCONT)
+}
+
+// In a cgo program APE's pthreads include threads of C's own, which are not
+// the runtime's ms: exit has APE end them (runtime/cgo's gcc_plan9.c).
+//
+//go:linkname _cgo_exitall _cgo_exitall
+var _cgo_exitall unsafe.Pointer
+
 func raisebadsignal(sig uint32) {
 	badsignal2()
 }
