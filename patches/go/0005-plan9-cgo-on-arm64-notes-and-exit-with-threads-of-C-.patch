diff --git a/src/runtime/sys_plan9_arm64.s b/src/runtime/sys_plan9_arm64.s
index 5100c06b..a097ee26 100644
--- a/src/runtime/sys_plan9_arm64.s
+++ b/src/runtime/sys_plan9_arm64.s
@@ -227,9 +227,15 @@ TEXT runtime·tstart_plan9(SB),NOSPLIT,$16-8
 
 //func sigtramp(ureg, note unsafe.Pointer)
 // The kernel calls it with R0 = ureg, the arguments at 8(RSP) and 16(RSP)
-// and LR = 0; g (R28) is the interrupted one. It never returns: noted
-// resumes the interrupted context.
+// and LR = 0; g (R28) is the interrupted one (without cgo). It never
+// returns: noted resumes the interrupted context.
 TEXT runtime·sigtramp(SB),NOSPLIT|NOFRAME,$0-16
+	// in a cgo program R28 may be C's (between its save and restore of
+	// it): g from its slot (tls_arm64.s; clobbers R0, the args are in FP)
+	MOVB	runtime·iscgo(SB), R1
+	CBZ	R1, 2(PC)
+	BL	runtime·load_g(SB)
+
 	// check that g and m exist
 	CBZ	g, bad
 	MOVD	g_m(g), R1
@@ -266,7 +272,10 @@ TEXT runtime·sigtramp(SB),NOSPLIT|NOFRAME,$0-16
 	BL	runtime·noted(SB)
 	B	0(PC)
 bad:
-	BL	runtime·badsignal2(SB)	// will exit
+	// no g: a proc of C's own in a cgo program
+	MOVD	note+8(FP), R0
+	MOVD	R0, 8(RSP)		// badnote's argument, over ureg's slot
+	BL	runtime·badnote(SB)	// does not return
 	B	0(PC)
 
 //func sigpanictramp()
diff --git a/src/runtime/tls_arm64.h b/src/runtime/tls_arm64.h
index 00f6bba8..632f155a 100644
--- a/src/runtime/tls_arm64.h
+++ b/src/runtime/tls_arm64.h
@@ -45,8 +45,8 @@
 #endif
 
 #ifdef GOOS_plan9
-// Plan 9 has no TLS and no cgo: g is only ever in R28 (load_g and save_g
-// return before this, iscgo being false).
+// Plan 9 has no TLS register: tls_arm64.s has load_g and save_g of its
+// own (a slot on the stack segment, with cgo); nothing here is used.
 #define TLSG_IS_VARIABLE
 #define MRS_TPIDR_R0 MOVD ZR, R0
 #endif
diff --git a/src/runtime/tls_arm64.s b/src/runtime/tls_arm64.s
index 52b3e8f2..01fcf4f5 100644
--- a/src/runtime/tls_arm64.s
+++ b/src/runtime/tls_arm64.s
@@ -8,6 +8,28 @@
 #include "textflag.h"
 #include "tls_arm64.h"
 
+#ifdef GOOS_plan9
+// Plan 9 has no TLS register: a proc's private slots are at a fixed
+// address in its stack segment, of which every proc has a copy. In a cgo
+// program (C may use R28 between saving and restoring it) g is also kept
+// in the word before the one _goprivates points at (runtime/cgo's
+// gcc_plan9.c: APE's _privates[1]). Clobbers R0.
+TEXT runtime·load_g(SB),NOSPLIT,$0
+	MOVB	runtime·iscgo(SB), R0
+	CBZ	R0, nocgo
+	MOVD	_goprivates(SB), R0
+	MOVD	-8(R0), g
+nocgo:
+	RET
+
+TEXT runtime·save_g(SB),NOSPLIT,$0
+	MOVB	runtime·iscgo(SB), R0
+	CBZ	R0, nocgo
+	MOVD	_goprivates(SB), R0
+	MOVD	g, -8(R0)
+nocgo:
+	RET
+#else
 TEXT runtime·load_g(SB),NOSPLIT,$0
 #ifndef GOOS_darwin
 #ifndef GOOS_openbsd
@@ -50,6 +72,8 @@ TEXT runtime·save_g(SB),NOSPLIT,$0
 nocgo:
 	RET
 
+#endif // GOOS_plan9
+
 #ifdef TLSG_IS_VARIABLE
 #ifdef GOOS_android
 // Use the free TLS_SLOT_APP slot #2 on Android Q.
